{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://www.desertscapeco.com/data/schemas/services.schema.json",
  "title": "DesertScape Services Data",
  "type": "object",
  "required": ["serviceGroups"],
  "properties": {
    "$schema": { "type": "string", "format": "uri" },
    "version": { "type": "string" },
    "serviceGroups": {
      "type": "array",
      "items": { "$ref": "#/$defs/servicePage" }
    },
    "focusedLandingPages": {
      "type": "array",
      "items": { "$ref": "#/$defs/servicePage" }
    }
  },
  "$defs": {
    "servicePage": {
      "type": "object",
      "required": ["id", "name", "url", "summary"],
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "url": { "type": "string", "format": "uri" },
        "summary": { "type": "string" },
        "keywords": {
          "type": "array",
          "items": { "type": "string" }
        }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
