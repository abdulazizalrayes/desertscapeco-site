{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://www.desertscapeco.com/data/schemas/agent-concierge.schema.json",
  "title": "DesertScape Agent Concierge Knowledge Contract",
  "type": "object",
  "required": [
    "version",
    "dateModified",
    "provenance",
    "policy",
    "topics"
  ],
  "properties": {
    "$schema": {
      "type": "string",
      "format": "uri"
    },
    "version": {
      "type": "string"
    },
    "dateModified": {
      "type": "string",
      "format": "date"
    },
    "lastVerified": {
      "type": "string",
      "format": "date"
    },
    "provenance": {
      "type": "object"
    },
    "policy": {
      "type": "object",
      "required": [
        "audience",
        "readOnly",
        "usesGenerativeAI",
        "externalModelCalls",
        "privateDataAccess",
        "credentialAccess",
        "maxQuestionLength"
      ],
      "properties": {
        "audience": {
          "type": "string"
        },
        "readOnly": {
          "const": true
        },
        "usesGenerativeAI": {
          "const": false
        },
        "externalModelCalls": {
          "const": false
        },
        "privateDataAccess": {
          "const": false
        },
        "credentialAccess": {
          "const": false
        },
        "maxQuestionLength": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2000
        }
      },
      "additionalProperties": true
    },
    "topics": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "title",
          "patterns",
          "answer",
          "sources"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9-]+$"
          },
          "title": {
            "type": "string"
          },
          "patterns": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "answer": {
            "type": "string",
            "maxLength": 1600
          },
          "sources": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "format": "uri"
            }
          },
          "nextAction": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
