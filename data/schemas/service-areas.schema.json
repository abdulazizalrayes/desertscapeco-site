{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://www.desertscapeco.com/data/schemas/service-areas.schema.json",
  "title": "DesertScape Service Areas Data",
  "type": "object",
  "required": ["primaryMarket", "supportedSaudiMarkets"],
  "properties": {
    "$schema": { "type": "string", "format": "uri" },
    "version": { "type": "string" },
    "primaryMarket": {
      "type": "object",
      "required": ["country", "countryCode", "city"],
      "properties": {
        "country": { "type": "string" },
        "countryCode": { "type": "string" },
        "city": { "type": "string" },
        "description": { "type": "string" }
      },
      "additionalProperties": true
    },
    "supportedSaudiMarkets": {
      "type": "array",
      "items": { "type": "string" }
    },
    "internationalSearchUseCases": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["originCountry", "intent"],
        "properties": {
          "originCountry": { "type": "string" },
          "intent": { "type": "string" }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
